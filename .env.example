# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.
# chmod 600 .env  after creating it.


VAULT_ADDR=http://vault:8200
VAULT_MOUNT=certificates

VAULT_PUBLIC_PREFIX=public
VAULT_INTERNAL_PREFIX=internal

VAULT_TIMEOUT_SECONDS=5

VAULT_TOKEN=YOUR_VAULT_TOKEN

VAULT_TOKEN_RENEW_INTERVAL_SECONDS=14400
VAULT_TOKEN_RENEW_RETRY_SECONDS=60

PORT=8080
