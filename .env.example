# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.
# chmod 600 .env  after creating it.

VAULT_ADDR=http://vault:8200
VAULT_TOKEN=REPLACE_WITH_DEDICATED_READ_ONLY_TOKEN
VAULT_MOUNT=certificates

VAULT_KV_PREFIX=public

VAULT_TIMEOUT_SECONDS=5

# Your Vault token period is 8 hours.
# Renew every 4 hours.
VAULT_TOKEN_RENEW_INTERVAL_SECONDS=14400

# Retry after 60 seconds if Vault is temporarily unavailable.
VAULT_TOKEN_RENEW_RETRY_SECONDS=60

PORT=8080
